# ─── Formulaire de contact ───
# Les messages partent vers axunt@aol.com.
# 1) Sans RESEND_API_KEY : FormSubmit (premier envoi = e-mail d'activation AOL).
# 2) Avec Resend : plus fiable en production.
#    https://resend.com/api-keys
#    Vercel → Project Settings → Environment Variables

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinataire des messages du formulaire
CONTACT_TO_EMAIL=axunt@aol.com

# Expéditeur
# Sans domaine vérifié : onboarding@resend.dev (compte Resend gratuit)
# En production avec domaine vérifié : Starlight <contact@votredomaine.com>
CONTACT_FROM_EMAIL=Starlight Manufacture <onboarding@resend.dev>

# URL publique du site (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://starlight-leather.com
